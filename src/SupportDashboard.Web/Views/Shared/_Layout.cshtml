@{
    var theme = Context.Request.Cookies["sd-theme"] == "dark" ? "dark" : "light";
    var current = ViewContext.RouteData.Values["controller"]?.ToString();
    bool IsActive(string controller) => string.Equals(current, controller, StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="en" data-theme="@theme" data-bs-theme="@theme">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Support Dashboard</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=Manrope:wght@600;700;800&display=swap" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="app-header">
        <nav class="navbar navbar-expand-lg" aria-label="Main">
            <div class="container-xxl">
                <a class="app-brand" asp-controller="Home" asp-action="Index">
                    <span class="app-brand__mark" aria-hidden="true">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h4l3-8 4 16 3-8h4" /></svg>
                    </span>
                    <span>Support Dashboard</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#app-nav" aria-controls="app-nav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="app-nav">
                    <ul class="navbar-nav app-nav me-auto">
                        <li class="nav-item"><a class="nav-link @(IsActive("Home") ? "active" : "")" aria-current="@(IsActive("Home") ? "page" : null)" asp-controller="Home" asp-action="Index">Overview</a></li>
                        <li class="nav-item"><a class="nav-link @(IsActive("Incidents") ? "active" : "")" aria-current="@(IsActive("Incidents") ? "page" : null)" asp-controller="Incidents" asp-action="Index">Incidents</a></li>
                        <li class="nav-item"><a class="nav-link @(IsActive("FunctionApps") ? "active" : "")" aria-current="@(IsActive("FunctionApps") ? "page" : null)" asp-controller="FunctionApps" asp-action="Index">Function Apps</a></li>
                        <li class="nav-item"><a class="nav-link @(IsActive("Pipelines") ? "active" : "")" aria-current="@(IsActive("Pipelines") ? "page" : null)" asp-controller="Pipelines" asp-action="Index">ADF Pipelines</a></li>
                        <li class="nav-item"><a class="nav-link @(IsActive("LogicApps") ? "active" : "")" aria-current="@(IsActive("LogicApps") ? "page" : null)" asp-controller="LogicApps" asp-action="Index">Logic Apps</a></li>
                    </ul>
                    <div class="app-tools">
                        <span class="env-pill">Production</span>
                        <button type="button" id="sound-toggle" class="icon-btn" aria-pressed="true" aria-label="New-ticket sound" title="New-ticket sound">
                            <svg class="icon-sound-on" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9" /><path d="M13.73 21a2 2 0 0 1-3.46 0" /></svg>
                            <svg class="icon-sound-off" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8.7 3.8A6 6 0 0 1 18 8c0 3.2.5 5.4 1.1 7" /><path d="M6.3 6.3A6 6 0 0 0 6 8c0 7-3 9-3 9h14" /><path d="M13.73 21a2 2 0 0 1-3.46 0" /><path d="M3 3l18 18" /></svg>
                        </button>
                        <button type="button" id="theme-toggle" class="icon-btn" aria-pressed="@(theme == "dark" ? "true" : "false")" aria-label="Dark mode" title="Dark mode">
                            <svg class="icon-theme-light" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8Z" /></svg>
                            <svg class="icon-theme-dark" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
                        </button>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main id="main" class="app-main">
        <div class="container-xxl">
            @RenderBody()
        </div>
    </main>

    <footer class="app-footer">
        <div class="container-xxl">Support Dashboard · showing sample data — not yet connected to ServiceNow or Azure</div>
    </footer>

    <div id="toast-region" class="toast-region" aria-live="polite"></div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
